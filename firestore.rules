rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Administrateur identifié par son adresse email vérifiée par Firebase Auth.
    // NB : sans Firebase Admin SDK / custom claims, c'est le meilleur contrôle
    //      applicable directement dans les règles. Pour changer d'admin,
    //      modifiez l'email ci-dessous puis redéployez les règles.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'zidadesire20@gmail.com';
    }

    // ── Marchés publics ──────────────────────────────────────────────
    // Lecture publique (les titres/catégories sont gratuits).
    //
    // ÉCRITURE : réservée au serveur. /api/scrape et /api/analyze-market
    // utilisent désormais le Firebase Admin SDK, qui contourne entièrement ces
    // règles — `if false` ne les gêne donc pas, mais ferme la porte au
    // navigateur. Auparavant `allow write: if true` laissait n'importe quel
    // visiteur modifier ou supprimer toute la collection produit.
    //
    // Seule exception client : la suppression manuelle depuis la console admin
    // (src/app/(admin)/admin/page.js), qui utilise le SDK client.
    match /marches/{marchId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ── Profils utilisateurs (PME) ───────────────────────────────────
    // Lecture : le propriétaire ou l'admin uniquement (fin de la fuite PII).
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // Création : uniquement son propre profil, non abonné par défaut,
      //   rôle USER imposé. Une fois créé, les champs sensibles sont
      //   verrouillés côté client : seul l'Admin SDK peut les modifier.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.isSubscribed == false
                    && request.resource.data.role == 'USER';

      // ⚠️ Champs sensibles : modifiables UNIQUEMENT via Firebase Admin SDK.
      //    Ces lignes vérifient que :
      //      - le client n'écrit PAS subscription/role/paymentStatus
      //        à une valeur DIFFÉRENTE de ce qui existe déjà
      //    (isAdmin() dans les règles = compte admin, mais Admin SDK
      //     bypass complètement les règles Firestore).
      function restrictedFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isSubscribed', 'subscriptionExpiresAt', 'role', 'paymentStatus', 'lastPaymentDate']);
      }

      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == userId && !restrictedFieldsChanged());

      // Suppression : admin uniquement.
      allow delete: if isAdmin();
    }

    // ── Candidatures : réservées au propriétaire ─────────────────────
    match /candidatures/{candidatureId} {
      allow read:   if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // ── Dossiers de marchés : réservés au propriétaire ───────────────
    // Chaque dossier est identifié par {userId}_{marcheId}
    match /dossiers/{dossierId} {
      // Lecture : autorisée si l'utilisateur est authentifié ET que le dossierId commence par son UID
      // Cela permet de lire même si le document n'existe pas encore (resource.data sera null)
      allow read:   if isSignedIn() && dossierId.matches(request.auth.uid + '_.*');
      
      // Création : l'utilisateur doit être authentifié et le userId dans le document doit correspondre
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && dossierId == request.auth.uid + '_' + request.resource.data.marcheId;
      
      // Mise à jour : vérifier que l'utilisateur est le propriétaire
      allow update: if isSignedIn() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      
      // Suppression : uniquement le propriétaire
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Demandes de paiement (contiennent des reçus / PII) ───────────
    // Le propriétaire crée et lit ses propres demandes ; seul l'admin peut
    // les lister toutes et changer leur statut (validation manuelle).
    match /payment_requests/{requestId} {
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Journal d'audit des actions admin (§9) ───────────────────────
    // Écrit et lu uniquement par l'admin. Jamais modifiable a posteriori.
    match /admin_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Runs du robot de scraping (suivi de santé §1/§10) ────────────
    // Écrits par /api/scrape via l'Admin SDK (qui contourne ces règles).
    // Lecture réservée à l'admin, aucune écriture depuis le navigateur.
    match /scrape_runs/{runId} {
      allow read:   if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ── Événements analytics (§2/§10) ────────────────────────────────
    // Collecte anonyme des visiteurs : le navigateur POST vers /api/track, qui
    // écrit via l'Admin SDK. La création directe était ouverte à tous, ce qui
    // permettait d'injecter n'importe quelle donnée analytique.
    // Append-only, lecture réservée à l'admin.
    match /events/{eventId} {
      allow read:   if isAdmin();
      allow create, update, delete: if false;
    }

    // ── Coupons promotionnels (§4) ───────────────────────────────────
    // Lecture : utilisateur connecté (validation d'un code au paiement).
    // Écriture : admin uniquement (création/activation/suppression).
    match /coupons/{couponId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
