# ============================================================================
# 🌐 WEND-KABRÉ — Variables d'Environnement (.env.example)
# Copier ce fichier en .env.local pour le développement, en .env en production,
# puis remplir les valeurs.
# ============================================================================

# ─── Application / URL Publique ─────────────────────────────────────────────
# URL publique racine de l'application (utile aux callbacks / redirections)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Base de Données PostgreSQL (si Next.js connecte direct) ────────────────
# Optionnel : la BDD des paiements est gérée par le payment-service séparé.
DATABASE_URL=postgresql://postgres:password@localhost:5432/wend_kabre?schema=public

# ─── Microservice Paiement (payment-service Node/Express) ───────────────────
# URL publique du service de paiement :
#   Dev      : http://localhost:5000
#   Render   : https://payment-service-wendkabre.onrender.com
#   Prod     : https://payment.wend-kabre.com
PAYMENT_SERVICE_URL=http://localhost:5000

# ─── Sécurité JWT (Partagé avec le payment-service pour les routes admin) ───
# Doit ÊTRE IDENTIQUE à JWT_SECRET du payment-service pour signer/lire tokens
# compatibles sur la route /api/payment/stats (admin)
JWT_SECRET=super_secret_jwt_key_change_me_at_least_32_bytes_long_please

# ─── Firebase (client, exposées au navigateur — normal) ──────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optionnel (Analytics) — référencé par src/lib/firebase.js
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin (Secret Serveur — Ne JAMAIS exposer publiquement) ───────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Scraper / cron ──────────────────────────────────────────────────
# Secret serveur pour déclencher /api/scrape en curl (à garder privé).
SCRAPER_SECRET=
# Jeton PUBLIC (exposé au client) pour le bouton "Forcer le scraper" de la
# console admin. Peu sensible : ne fait que lancer un scrape de flux RSS publics.
NEXT_PUBLIC_SCRAPER_SECRET=
# Secret du cron Vercel. Vercel envoie automatiquement
# `Authorization: Bearer <CRON_SECRET>` aux routes planifiées.
CRON_SECRET=

# ─── Email (nodemailer / Gmail) — optionnel ──────────────────────────
EMAIL_USER=
EMAIL_APP_PASSWORD=

