{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": ["src/**/*"],
  // Les tests sont exécutés par Vitest (esbuild), pas par tsc : les inclure
  // ferait échouer le build de production et enverrait du code de test dans dist/.
  "exclude": ["node_modules", "dist", "prisma", "src/**/*.test.ts"]
}
