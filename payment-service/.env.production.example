# ============================================================================
# ⚙️ PAYMENT-SERVICE — VARIABLES D'ENVIRONNEMENT PRODUCTION
# Wend-Kabré Microservice Paiement Money Fusion
# ============================================================================

# ─── Serveur ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ─── URLs Publiques du service (callback + return) ─────────────────────────
RENDER_EXTERNAL_URL=https://payment-service-wendkabre.onrender.com

# ─── URL Publique du Frontend Next.js (retour utilisateur après paiement) ─
# IMPORTANT : SANS FIN /
#   Domaine custom exemple :  https://wend-kabre.com
#   Ou URL Vercel/Render web : https://wend-kabre-bf.vercel.app
APP_URL=https://wend-kabre.com

# ─── PostgreSQL Supabase (Prisma ORM) ─────────────────────────────────────
DATABASE_URL=postgres://postgres.kpvrsptqnstyzjkfraex:MOT_DE_PASSE_A_REMPLACER@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# ─── Sécurité JWT (Route /api/payment/stats) ──────────────────────────────
JWT_SECRET=remplacer_par_une_cle_aleatoire_32_octets_minimum_IDEM_QUE_BACKEND_PRINCIPAL

# ─── Passerelle Money Fusion — API Production ─────────────────────────────
MONEY_FUSION_API_URL=https://api.moneyfusion.net/v1
MONEY_FUSION_TOKEN=remplacer_par_votre_token_money_fusion_production
MONEY_FUSION_API_KEY=remplacer_par_votre_api_key_money_fusion_production
MONEY_FUSION_WEBHOOK_SECRET=remplacer_par_le_secret_webhook_configure_chez_money_fusion

# ─── Devise par défaut ─────────────────────────────────────────────────────
PAYMENT_CURRENCY=XOF

# ─── IP Whitelist Money Fusion (optionnel, séparées par virgule) ───────────
MONEY_FUSION_ALLOWED_IPS=

# ⚠️ SÉCURITÉ : NE JAMAIS COMMITTER DE VRAIES VALEURS DANS GIT.
