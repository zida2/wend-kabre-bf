# Server Configuration
PORT=5000
NODE_ENV=development
RENDER_EXTERNAL_URL=https://payment-service-wendkabre.onrender.com

# Frontend Next.js (sans / final) : dev local
APP_URL=http://localhost:3000

# PostgreSQL Database (Render PostgreSQL or local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/wend_kabre_payment?schema=public

# JWT Security
JWT_SECRET=super_secret_jwt_key_wend_kabre_2026_bf

# Money Fusion Gateway Configuration
MONEY_FUSION_API_URL=https://api.moneyfusion.net/v1
MONEY_FUSION_TOKEN=your_money_fusion_api_token
MONEY_FUSION_API_KEY=your_money_fusion_api_key
MONEY_FUSION_WEBHOOK_SECRET=your_webhook_secret_key

# Default Currency
PAYMENT_CURRENCY=XOF

# Secret partagé avec l'application Next.js. Permet au webhook Money Fusion de
# déclencher POST {APP_URL}/api/subscription/sync dès qu'un paiement est validé,
# sans attendre que le client revienne sur le site.
# Doit être IDENTIQUE à l'APP_SYNC_SECRET de l'application Next.js.
APP_SYNC_SECRET=
